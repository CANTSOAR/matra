{
  "name": "matra",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "description": "Matra \u2014 One-Touch Justice Pipeline (MVP)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w @matra/server\" \"npm run dev -w @matra/web\"",
    "fetch-models": "node scripts/fetch-models.mjs",
    "build": "node scripts/fetch-models.mjs && npm run build -w @matra/web && node scripts/audit-web-build.mjs",
    "audit:web": "node scripts/audit-web-build.mjs",
    "start": "npm run start -w @matra/server",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed -w @matra/server",
    "demo": "node scripts/demo.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "e2e": "playwright test && playwright test -c playwright.demo.config.ts",
    "e2e:demo": "playwright test -c playwright.demo.config.ts",
    "e2e:prod": "playwright test -c playwright.prod.config.ts",
    "legal": "node scripts/legal-bank.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
